# Copie para agent/.env e preencha com as credenciais reais.
# Nunca versione o .env — ele já está no .gitignore.
#
# Em produção estas variáveis vivem no painel do Railway, não neste repositório.
# Esta lista foi conferida contra `grep -r "process.env" agent/src/`.

# --- Supabase ---
# A chave SECRETA (sb_secret_..., antiga service_role), não a publishable.
# Ela ignora RLS, e é a única que enxerga a tabela `conversas` — com a chave
# publishable a consulta devolve lista vazia, sem erro, o que engana.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXX
# Opcional. Sem ela, o padrão é claude-sonnet-4-5.
ANTHROPIC_MODEL=

# --- Telegram ---
# Token do bot, obtido no @BotFather.
TELEGRAM_BOT_TOKEN=
# Chat ids autorizados, separados por vírgula. Vazio libera qualquer pessoa
# que descubra a URL do webhook.
TELEGRAM_ALLOWED_IDS=
# Deve ser igual ao secret_token informado no setWebhook; todo update que não
# trouxer este valor no header é rejeitado com 403.
TELEGRAM_WEBHOOK_SECRET=
# Chat que recebe o relatório de auditoria das 23h. Tem padrão embutido no código.
AUDITORIA_CHAT_ID=

# --- Groq (transcrição de áudio) ---
# Só afeta mensagens de voz; sem ela o texto continua funcionando.
GROQ_API_KEY=

# --- Endpoints de teste ---
# Sem esta variável os endpoints /test/* ficam desabilitados (respondem 403).
TEST_ENDPOINT_SECRET=

# --- Runtime ---
# Usado na comparação de horário dos digests agendados.
TZ=America/Sao_Paulo
PORT=3000
