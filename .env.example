# Copie este arquivo para .env.local e preencha com suas credenciais reais.
# Nunca versione o .env.local — ele já está no .gitignore.

# URL do projeto Supabase (encontrada em: Project Settings > API)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave pública (anon/publishable) do Supabase (encontrada em: Project Settings > API)
VITE_SUPABASE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
